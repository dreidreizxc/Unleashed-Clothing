# Copy this file to `functions/.env` before deploying Cloud Functions.
# Never commit `functions/.env`; it contains secrets.
#
# The OTP backend requires OTP_HASH_SECRET, OTP_FROM_EMAIL and one provider key.
# Firebase CLI deploys `.env` values as environment variables for the functions.

OTP_HASH_SECRET=replace-with-a-long-random-string
OTP_FROM_EMAIL=verified-sender@example.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional overrides (defaults shown).
# OTP_CODE_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_PER_HOUR=5
